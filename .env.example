# ==== Общие ====
# API-ключи сервисов и пользователей: "role:SHA256(token)".
# Сгенерировать хэш: python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print(t,hashlib.sha256(t.encode()).hexdigest())"
API_KEYS=admin:PUT_SHA256_HERE,operator:PUT_SHA256_HERE
# Внутренний ключ, которым SOAR/pentest ходят в санитайзер (роль operator)
SANITIZER_SERVICE_KEY=PUT_RAW_OPERATOR_TOKEN_HERE

# ==== Локальная модель ====
# Флаг локального движка. По умолчанию поднимается контейнер ollama.
# Для ВНЕШНЕГО Ollama — очистите значение (COMPOSE_PROFILES=) и задайте OLLAMA_URL ниже:
# тогда локальный ollama не стартует, всё ходит на внешний адрес.
COMPOSE_PROFILES=local-model

# OLLAMA_URL — ЕДИНАЯ точка для ВСЕГО, что использует модель: оркестратора
# и ИИ-мишеней (vulnllm, ragapp). Меняете здесь — переключается всё разом.
#   локально (по умолчанию):      http://ollama:11434
#   Ollama на другом сервере:     http://<ip-сервера>:11434
#     (для внешнего: COMPOSE_PROFILES= выше пусто -> локальный ollama не стартует;
#      внешний Ollama должен слушать 0.0.0.0 и быть сетево доступен)
OLLAMA_URL=http://ollama:11434
# Имя модели, которая ЗАГРУЖЕНА в этом Ollama (ollama pull <model>).
# Мало памяти -> qwen2.5:7b (~8-12 ГБ) или llama3.1:8b.
# Совсем слабое железо -> qwen2.5:3b (~2-3 ГБ): мишни vulnllm/ragapp тянет, но
# оркестратору JSON-планирование даётся хуже (возможны _parse_error) — тогда 7b.
LOCAL_MODEL=qwen2.5:32b

# ==== Внешний ИИ (только ZDR-тариф / opt-out обучения!) ====
# ALLOW_EXTERNAL=false — жёстко блокирует любой внешний путь (только локальная модель).
# Чтобы разбор/оркестрация по умолчанию шли во внешний ИИ (через санитайзер) —
# поставьте ALLOW_EXTERNAL=true и DEFAULT_ROUTE=external.
ALLOW_EXTERNAL=false

# DEFAULT_ROUTE — маршрут по умолчанию для оркестрации (planner) и разбора вывода
# в pentest, и для разбора инцидента в soar:  local | external
# (external реально сработает только при ALLOW_EXTERNAL=true).
DEFAULT_ROUTE=local

# EXTERNAL_PROVIDER: anthropic | yandex | openai
#   yandex  = YandexGPT (модель «Алисы»), openai = OpenAI-совместимый эндпоинт.
EXTERNAL_PROVIDER=anthropic
EXTERNAL_URL=https://api.anthropic.com
EXTERNAL_MODEL=claude-sonnet-4-6
EXTERNAL_API_KEY=PUT_ENTERPRISE_ZDR_KEY_HERE

# --- Пример: Алиса / YandexGPT (Yandex Cloud Foundation Models) ---
# Раскомментируйте и заполните, чтобы весь внешний разбор шёл в YandexGPT:
#   ALLOW_EXTERNAL=true
#   DEFAULT_ROUTE=external
#   EXTERNAL_PROVIDER=yandex
#   EXTERNAL_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
#   EXTERNAL_MODEL=yandexgpt/latest        # или yandexgpt-lite/latest, либо gpt://<folder>/<model>
#   EXTERNAL_API_KEY=<Api-Key сервисного аккаунта Yandex Cloud>
#   YANDEX_FOLDER_ID=<b1g... id каталога>
YANDEX_FOLDER_ID=
