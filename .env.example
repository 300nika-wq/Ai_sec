# ==== Общие ====
# API-ключи пользователей: "role:SHA256(token)".
# Сгенерировать хэш: python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print(t,hashlib.sha256(t.encode()).hexdigest())"
API_KEYS=admin:PUT_SHA256_HERE,operator:PUT_SHA256_HERE

# ==== Локальная модель (Ollama) ====
# Флаг локального движка. По умолчанию поднимается контейнер ollama.
# Для ВНЕШНЕГО Ollama — очистите значение (COMPOSE_PROFILES=) и задайте OLLAMA_URL:
# тогда локальный ollama не стартует, pentest ходит на внешний адрес.
COMPOSE_PROFILES=local-model

# OLLAMA_URL — адрес модели. Оркестратор (pentest) и ИИ-мишени (vulnllm, ragapp)
# читают его. Адрес модели можно поменять и на лету в панели (Lab dashboard ->
# «Настройки ИИ»).
#   локально (по умолчанию):      http://ollama:11434
#   Ollama на другом сервере:     http://<ip-сервера>:11434
#     (для внешнего: COMPOSE_PROFILES= выше пусто -> локальный ollama не стартует;
#      внешний Ollama должен слушать 0.0.0.0 и быть сетево доступен)
OLLAMA_URL=http://ollama:11434
# Имя модели, которая ЗАГРУЖЕНА в этом Ollama (ollama pull <model>).
# Мало памяти -> qwen2.5:7b (~8-12 ГБ) или llama3.1:8b.
# Совсем слабое железо -> qwen2.5:3b (~2-3 ГБ): мишени vulnllm/ragapp тянет, но
# оркестратору JSON-планирование даётся хуже (возможны _parse_error) — тогда 7b.
LOCAL_MODEL=qwen2.5:7b

# ==== garak (опциональный отдельный стек, docker-compose.garak.yml) ====
# Адрес мишени можно менять на лету в панели pentest (Lab dashboard ->
# «Изменить адрес мишени»); новый host добавляется в scope автоматически.
# Для garak-стека:
#   GARAK_ALLOWED_HOSTS — какие хосты garak вообще разрешено сканировать;
#   GARAK_ALLOW_ANY_HOST=true — снять allowlist (мишени на произвольных хостах).
GARAK_ALLOWED_HOSTS=vulnllm,ragapp,ollama,127.0.0.1,localhost
GARAK_ALLOW_ANY_HOST=false
